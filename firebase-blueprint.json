{
  "entities": {
    "AdSiteConfig": {
      "title": "AdSiteConfig",
      "description": "Global site-wide advertising and Google AdSense configuration for SNOX Sports",
      "type": "object",
      "properties": {
        "adsEnabled": {
          "type": "boolean",
          "description": "Master toggle for displaying ads across SNOX Sports"
        },
        "adsenseClientId": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^(|ca-pub-[0-9]{10,20})$",
          "description": "Google AdSense publisher ID (ca-pub-...)"
        },
        "slotBannerId": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^(|[0-9]{6,15})$",
          "description": "Google AdSense ad slot ID for main match & watch banners"
        },
        "slotNewsId": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^(|[0-9]{6,15})$",
          "description": "Google AdSense ad slot ID for news feed inline banner"
        },
        "slotSidebarId": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^(|[0-9]{6,15})$",
          "description": "Google AdSense ad slot ID for sidebar placement"
        },
        "customScriptUrl": {
          "type": "string",
          "maxLength": 500,
          "pattern": "^(|https://.+)$",
          "description": "Optional verified HTTPS external ad network script URL"
        },
        "adsTxtLine": {
          "type": "string",
          "maxLength": 200,
          "description": "ads.txt publisher authorization line"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Admin UID who last updated site ad config"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update"
        }
      },
      "required": [
        "adsEnabled",
        "adsenseClientId",
        "slotBannerId",
        "slotNewsId",
        "slotSidebarId",
        "customScriptUrl",
        "adsTxtLine",
        "updatedBy",
        "updatedAt"
      ]
    },
    "AdCampaign": {
      "title": "AdCampaign",
      "description": "Direct sponsor, affiliate, or image banner campaign displayed across SNOX Sports",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "Campaign headline"
        },
        "subtitle": {
          "type": "string",
          "maxLength": 260,
          "description": "Campaign description"
        },
        "ctaText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Action button label"
        },
        "targetUrl": {
          "type": "string",
          "minLength": 8,
          "maxLength": 500,
          "pattern": "^https?://.+",
          "description": "Destination link for the sponsored ad"
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional banner image URL"
        },
        "placement": {
          "type": "string",
          "enum": ["all", "main_banner", "news_feed", "watch_banner", "sidebar"],
          "description": "Placement slot on the site"
        },
        "active": {
          "type": "boolean",
          "description": "Whether the campaign is currently published to visitors"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "UID of the admin owner who created this campaign"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "title",
        "subtitle",
        "ctaText",
        "targetUrl",
        "imageUrl",
        "placement",
        "active",
        "ownerUid",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/siteConfig/{docId}": {
      "schema": {
        "$ref": "#/entities/AdSiteConfig"
      },
      "description": "Global site-wide advertising configuration (docId = 'ads')"
    },
    "/campaigns/{campaignId}": {
      "schema": {
        "$ref": "#/entities/AdCampaign"
      },
      "description": "Direct sponsor and affiliate ad campaigns published on SNOX Sports"
    }
  }
}
